; Engine configuration file.
; Edit through the Godot editor where possible.
config_version=5

[application]

config/name="Open World Racing"
run/main_scene="res://src/bootstrap/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

AppEvents="*res://src/core/app_events.gd"
GameLogger="*res://src/core/logger.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

environment/defaults/default_clear_color=Color(0.035, 0.043, 0.055, 1)
