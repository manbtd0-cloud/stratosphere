+		transform.basis.y.x, transform.basis.y.y, transform.basis.y.z,
+		transform.basis.z.x, transform.basis.z.y, transform.basis.z.z,
+	]
+	var parts := PackedStringArray()
+	for value in values:
+		parts.append("%.4f" % snappedf(float(value), 0.0001))
